{
  "name": "@yuhi-ai-labs/yuhi",
  "version": "0.3.2",
  "type": "module",
  "description": "See exactly what your AI agent can see — then run it on a locally-prepared copy of your repo. Local-first, no telemetry.",
  "keywords": [
    "ai",
    "claude-code",
    "ai-agent",
    "context",
    "privacy",
    "local-first",
    "pseudonymize",
    "secrets",
    "developer-tools",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "YUHI AI Labs",
  "homepage": "https://github.com/YUHI-AI-Labs/yuhi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUHI-AI-Labs/yuhi.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/YUHI-AI-Labs/yuhi/issues"
  },
  "bin": {
    "yuhi": "dist/index.js"
  },
  "files": [
    "dist",
    "locales",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1",
    "picomatch": "^4.0.2",
    "ignore": "^6.0.2"
  },
  "optionalDependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@yuhi/shared": "workspace:*",
    "@yuhi/config": "workspace:*",
    "@yuhi/core": "workspace:*",
    "@yuhi/local": "workspace:*",
    "@yuhi/agents": "workspace:*"
  }
}
