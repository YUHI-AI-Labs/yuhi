{
  "name": "yuhi-vscode",
  "displayName": "Yuhi \u2014 AI-Ready Repositories",
  "description": "Scan, sanitize, convert, and reduce your repository before opening it with an AI coding agent. Local-first, no telemetry.",
  "version": "0.3.7",
  "publisher": "yuhi-ai-labs",
  "license": "Apache-2.0",
  "icon": "media/yuhi-ai-labs-icon.png",
  "galleryBanner": {
    "color": "#0c1017",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude-code",
    "ai-coding-agent",
    "context-management",
    "privacy",
    "local-first",
    "security",
    "ollama",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YUHI-AI-Labs/yuhi.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://github.com/YUHI-AI-Labs/yuhi",
  "bugs": {
    "url": "https://github.com/YUHI-AI-Labs/yuhi/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yuhi",
          "title": "Claude Code with Yuhi",
          "icon": "media/yuhi-activity.svg"
        }
      ]
    },
    "views": {
      "yuhi": [
        {
          "id": "yuhi.workspace",
          "name": "Claude Code with Yuhi",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "yuhi.doctor",
        "title": "Yuhi: Doctor"
      },
      {
        "command": "yuhi.setupLocalAI",
        "title": "Yuhi: Setup Local AI"
      },
      {
        "command": "yuhi.prepareWorkspace",
        "title": "Yuhi: Prepare Workspace"
      },
      {
        "command": "yuhi.reviewPrepared",
        "title": "Yuhi: Review Prepared Context"
      },
      {
        "command": "yuhi.prepareHere",
        "title": "Prepare with Yuhi"
      },
      {
        "command": "yuhi.prepareAndOpen",
        "title": "Yuhi: Prepare and Open in New Window",
        "icon": "$(open-preview)"
      },
      {
        "command": "yuhi.prepareAndStartClaude",
        "title": "Yuhi: Prepare and Start Claude Code",
        "icon": "$(shield)"
      },
      {
        "command": "yuhi.openClaudeHere",
        "title": "Yuhi: Open Claude Code in Prepared Workspace",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "yuhi.switchWorkspace",
        "title": "Yuhi: Switch Workspace and Start Claude Code",
        "icon": "$(folder-opened)"
      },
      {
        "command": "yuhi.exitWorkspace",
        "title": "Yuhi: Exit Prepared Workspace",
        "icon": "$(sign-out)"
      },
      {
        "command": "yuhi.restartFlow",
        "title": "Yuhi: Start Over and Choose Source Folder",
        "icon": "$(refresh)"
      },
      {
        "command": "yuhi.openSourceWorkspace",
        "title": "Yuhi: Open Source Workspace",
        "icon": "$(folder)"
      },
      {
        "command": "yuhi.dismissPreviousRun",
        "title": "Yuhi: Dismiss Previous Run",
        "icon": "$(close)"
      },
      {
        "command": "yuhi.reviewAgentChanges",
        "title": "Yuhi: Review Agent Changes",
        "icon": "$(diff)"
      },
      {
        "command": "yuhi.showRecovery",
        "title": "Yuhi: Open Recovery Options",
        "icon": "$(tools)"
      },
      {
        "command": "yuhi.launchAgent",
        "title": "Yuhi: Launch Agent (Claude Code / Codex)"
      },
      {
        "command": "yuhi.launchClaudeDynamic",
        "title": "Yuhi: Start Claude Code with Dynamic Context"
      },
      {
        "command": "yuhi.showDynamicStats",
        "title": "Yuhi: Show Dynamic Context Stats"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yuhi.prepareHere",
          "when": "false"
        },
        {
          "command": "yuhi.doctor",
          "when": "false"
        },
        {
          "command": "yuhi.setupLocalAI",
          "when": "false"
        },
        {
          "command": "yuhi.prepareWorkspace",
          "when": "false"
        },
        {
          "command": "yuhi.reviewPrepared",
          "when": "false"
        },
        {
          "command": "yuhi.prepareAndOpen",
          "when": "false"
        },
        {
          "command": "yuhi.openClaudeHere",
          "when": "false"
        },
        {
          "command": "yuhi.switchWorkspace",
          "when": "false"
        },
        {
          "command": "yuhi.exitWorkspace",
          "when": "false"
        },
        {
          "command": "yuhi.restartFlow",
          "when": "false"
        },
        {
          "command": "yuhi.openSourceWorkspace",
          "when": "false"
        },
        {
          "command": "yuhi.dismissPreviousRun",
          "when": "false"
        },
        {
          "command": "yuhi.reviewAgentChanges",
          "when": "false"
        },
        {
          "command": "yuhi.showRecovery",
          "when": "false"
        },
        {
          "command": "yuhi.launchAgent",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "yuhi.prepareAndStartClaude",
          "group": "yuhi@1"
        }
      ]
    },
    "configuration": {
      "title": "Yuhi",
      "properties": {
        "yuhi.safetyMode": {
          "type": "string",
          "enum": [
            "balanced",
            "strict",
            "maximum-privacy"
          ],
          "enumDescriptions": [
            "Recommended for most repositories.",
            "More conservative handling for business repositories.",
            "Shares the minimum context allowed by current Yuhi policies."
          ],
          "default": "balanced",
          "scope": "resource",
          "description": "Safety Mode preset applied when Yuhi prepares this workspace. Changing it takes effect the next time you prepare (re-prepare) the workspace."
        },
        "yuhi.compress": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Compress source structure (drop implementation bodies, keep signatures) to reduce tokens."
        },
        "yuhi.compressionMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Do not create compact context representations.",
            "Automatically create safe compact representations when useful (recommended).",
            "Always enable safe compression; use the optional best-effort Token Budget."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "How Yuhi prepares compact repository context. Auto is recommended; failed compression always falls back to the full file."
        },
        "yuhi.permissionMode": {
          "type": "string",
          "enum": [
            "standard",
            "plan",
            "acceptEdits",
            "auto",
            "custom"
          ],
          "default": "standard",
          "scope": "resource",
          "description": "Claude Code permission mode used in Yuhi Mode. Yuhi does not disable Auto mode globally."
        },
        "yuhi.sandboxPreset": {
          "type": "string",
          "enum": [
            "standard",
            "guarded",
            "locked-down"
          ],
          "enumDescriptions": [
            "Use Claude Code defaults; Yuhi adds no permission restrictions.",
            "Enable Claude's sandbox while preserving Auto mode and prompting for unsandboxed commands.",
            "Apply Yuhi's strict sandbox restrictions; Auto or bypass capabilities may be limited."
          ],
          "default": "guarded",
          "scope": "resource",
          "description": "Runtime sandbox preset. Repository preparation and Safe Apply remain enforced independently."
        },
        "yuhi.tokenBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1000000000,
          "scope": "resource",
          "description": "Target token budget for the prepared context. Enable Context Compression first. Use 0 for No target; positive whole numbers are best-effort targets."
        },
        "yuhi.alwaysIncludeWarningExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          },
          "default": [],
          "scope": "resource",
          "description": "File extensions explicitly allowed with inspection warnings. Known credentials and policy blocks still remain excluded."
        },
        "yuhi.alwaysExcludeExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          },
          "default": [],
          "scope": "resource",
          "description": "File extensions explicitly kept out of the Prepared Workspace."
        },
        "yuhi.dynamicContext.retrievalMode": {
          "type": "string",
          "enum": [
            "disabled",
            "conditional",
            "required"
          ],
          "default": "disabled",
          "description": "Retrieval capability shown to the agent during a dynamic context session. Measured: registering the retrieval tools adds ~507 tokens to every request and costs extra agent turns, so the default is disabled. Originals stay privately stored and retrievable in every mode."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies -o yuhi.vsix",
    "inspect:vsix": "node scripts/inspect-vsix.mjs yuhi.vsix"
  },
  "dependencies": {
    "@yuhi/agents": "workspace:*",
    "@yuhi/core": "workspace:*",
    "@yuhi/local": "workspace:*",
    "@yuhi/shared": "workspace:*",
    "@yuhi/config": "workspace:*",
    "yaml": "^2.6.1",
    "@yuhi/context-gateway": "workspace:*"
  },
  "optionalDependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.17.9",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0"
  }
}
