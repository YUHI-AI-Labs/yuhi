# Source & build tooling — never shipped in the VSIX.
src/**
tests/**
scripts/**
**/*.ts
**/*.map
esbuild.mjs
tsconfig.json
**/tsconfig.json
.vscode-test/**
node_modules/**
.yuhi/**
yuhi.yaml
HANDOFF.md
**/HANDOFF.md

# Secrets / env — must never be packaged.
.env
.env.*
**/.env
**/.env.*

# Repo docs kept out of the VSIX (README, CHANGELOG, LICENSE, media/yuhi-ai-labs-icon.png ships).
PRIVACY.md
SECURITY.md
media/eye.svg
media/icon.svg

# Build artifacts / packaging output.
*.vsix
# Release-staging files. These land in this directory while a release is prepared and
# vsce would otherwise bundle them INTO the extension: a 0.4.4 build shipped the 562 KB
# 0.4.3 npm tarball and a SHA256SUMS.txt before this rule existed.
*.tgz
*.tar.gz
*.zip
SHA256SUMS.txt
SHA256SUMS*
