# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
coverage/
.vitest/

# Yuhi runtime data (generated workspaces, audit logs)
.yuhi/
!examples/**/.yuhi-keep

# Editor / OS
.DS_Store
.idea/
*.log

# VSIX build artifacts
apps/vscode/*.vsix

# Env
.env
.env.*
!.env.example

# Demo fixture (intentional fake secrets for the walkthrough)
!examples/demo/.env
HANDOFF.md
MIGRATION_HANDOFF.md

# Local working brief — never commit (contains local notes)
WEBSITE_RENEWAL_INSTRUCTION.md
apps/vscode/*.vsix

# build artifacts — never committed; regenerate with `npm pack`
apps/cli/*.tgz
# Release-staging copies. These are built artifacts that get staged next to the
# extension while a release is prepared; a 562 KB tarball was committed once because
# only apps/cli/*.tgz was ignored.
apps/vscode/*.tgz
apps/vscode/SHA256SUMS.txt
