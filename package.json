{
  "name": "yuhi-monorepo",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "description": "Yuhi — a local-first secure workspace runtime for AI coding agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "schema": "tsx scripts/generate-schema.ts",
    "yuhi": "tsx apps/cli/src/index.ts",
    "release:cli:build": "pnpm --filter @yuhi-ai-labs/yuhi build",
    "release:cli:check": "pnpm --filter @yuhi-ai-labs/yuhi build && pnpm --filter @yuhi-ai-labs/yuhi exec npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@yuhi/agents": "workspace:*",
    "@yuhi/config": "workspace:*",
    "@yuhi/core": "workspace:*",
    "@yuhi/policy": "workspace:*",
    "@yuhi/scanner": "workspace:*",
    "@yuhi/shared": "workspace:*",
    "@yuhi/workspace": "workspace:*",
    "@types/node": "^20.17.9",
    "@types/picomatch": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@yuhi/processors": "workspace:*"
  }
}
